<view class="map-page">
  <!-- 地图 -->
  <map
    id="mainMap"
    class="main-map"
    style="height: {{mapHeight}}px;"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location
    enable-zoom
    enable-scroll
    enable-rotate="{{false}}"
    bindregionchange="onRegionChange"
    bindmarkertap="onMarkerTap"
  />

  <!-- 顶部标题栏 -->
  <view class="top-bar">
    <view class="top-bar-inner">
      <text class="top-title">观之</text>
    </view>
  </view>

  <!-- 回到定位按钮 -->
  <view class="locate-btn" bindtap="moveToLocation">
    <image class="locate-icon" src="/assets/icon-locate.png" mode="aspectFit" />
  </view>

  <!-- 选中卡片 -->
  <view class="card-overlay {{showCard ? 'visible' : ''}}" bindtap="closeCard">
    <view class="preview-card" catchtap="goToDetail" wx:if="{{selectedShare}}">
      <image
        class="card-cover"
        src="{{selectedShare.coverUrl || selectedShare.thumbnailUrl}}"
        mode="aspectFill"
        wx:if="{{selectedShare.coverUrl || selectedShare.thumbnailUrl}}"
      />
      <view class="card-placeholder" wx:else>
        <text class="card-placeholder-text">无封面</text>
      </view>
      <view class="card-info">
        <view class="card-author">
          <image class="card-avatar" src="{{selectedShare.userAvatar}}" mode="aspectFill" />
          <text class="card-nickname">{{selectedShare.nickname}}</text>
        </view>
        <text class="card-content text-ellipsis-2">{{selectedShare.content}}</text>
        <view class="card-meta">
          <text class="card-address text-ellipsis" wx:if="{{selectedShare.address}}">{{selectedShare.address}}</text>
          <text class="card-action">查看详情 ></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部引导 -->
  <app-guide position="bottom" />
</view>
