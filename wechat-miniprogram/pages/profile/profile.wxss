.profile-page {
  width: 100%;
  min-height: 100vh;
  background: #f5f5f5;
}

.profile-scroll {
  height: 100vh;
}

/* 加载动画 */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a1a1a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 头部区域 */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 40rpx;
  background: #fff;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-bottom: 20rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.profile-stats {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.profile-level {
  font-size: 24rpx;
  color: #fff;
  background: #1a1a1a;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.profile-bio {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
  max-width: 80%;
}

/* 分享列表区域 */
.profile-section {
  margin-top: 16rpx;
  padding: 0 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-count {
  font-size: 26rpx;
  color: #999;
  margin-left: 12rpx;
}

.card-wrapper {
  margin-bottom: 16rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 32rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.open-app-btn {
  width: 100%;
  height: 88rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 88rpx;
}

.open-app-btn::after {
  border: none;
}
